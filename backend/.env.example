DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://hardblockuno.github.io,null
CORS_ALLOW_ALL_ORIGINS=0

POSTGRES_DB=consulta_habitacional
POSTGRES_USER=consulta_user
POSTGRES_PASSWORD=consulta_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

AHORRO_MINIMO_UF=10

# Extraccion Rukan sin costo por documento. Requiere Tesseract OCR instalado localmente.
RUKAN_AI_PROVIDER=tesseract
RUKAN_TESSERACT_CMD=
RUKAN_TESSERACT_LANG=eng
RUKAN_OCR_IMAGE_MAX_SIDE=3000

# Alternativa visual local con Ollama. Es mas lenta en equipos sin GPU.
RUKAN_OLLAMA_URL=http://127.0.0.1:11434
RUKAN_OLLAMA_MODEL=qwen2.5vl:3b
RUKAN_OLLAMA_TIMEOUT_SECONDS=180
RUKAN_OLLAMA_CONTEXT_WINDOW=8192
RUKAN_OLLAMA_IMAGE_MAX_SIDE=1800
RUKAN_OLLAMA_MAX_OUTPUT_TOKENS=700

# Alternativa opcional de pago mediante OpenAI. No subas esta clave a GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT_SECONDS=90
RUKAN_AI_MAX_BYTES=12582912
